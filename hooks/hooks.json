{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}${/}hooks${/}jevqueue_gate.py\" || python \"${extensionPath}${/}hooks${/}jevqueue_gate.py\"",
            "name": "jevqueue-gate",
            "description": "Refuses a tool call the decision layer says should not run.",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${extensionPath}${/}hooks${/}jevqueue_session.py\" || python \"${extensionPath}${/}hooks${/}jevqueue_session.py\"",
            "name": "jevqueue-awareness",
            "description": "Introduces the decision queue at the start of a session.",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
